digraph diagram {
    rankdir = LR
    ranksep = 2.5
    nodesep = 1

    fontname="Helvetica,Arial,sans-serif"

    node [shape = box; width = 1.0; height = 0.5; style = filled; fillcolor = "#CCCCCC"]
    edge [arrowhead = vee]

    Virt
    VirtAddr [label = "x86_64::VirtAddr"]
    Page

    VirtAddr:ne -> Virt:nw [label = "from()"]
    Virt:sw -> VirtAddr:se [constraint = false; label = "into()"]

    Virt:ne -> Page:nw [label = "Page::new()"]
    Page:sw -> Virt:se [constraint = false; label = "Page::address()"]
}
