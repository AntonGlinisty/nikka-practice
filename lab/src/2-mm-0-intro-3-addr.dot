digraph diagram {
    rankdir = LR
    ranksep = 1.5
    nodesep = 1

    fontname="Helvetica,Arial,sans-serif"

    node [shape = box; width = 1.0; height = 0.5; style = filled; fillcolor = "#CCCCCC"]
    edge [arrowhead = vee; labelfloat = false]

    u64
    usize
    Addr
    Frage

    { rank = same; usize; u64 }

    usize:sw -> u64:nw [xlabel = "ku::memory::size::into_u64()"]
    u64:n -> usize:s [label = "ku::memory::size::from()"]

    usize:ne -> Addr:n [label = "Addr::new()"]
    u64:ne -> Addr:sw [label = "Addr::new_u64()"]

    Addr:nw -> usize:se [label = "Addr::into_usize()"]
    Addr:s -> u64:se [label = "Addr::into_u64()"]

    Addr:ne -> Frage:nw [label = "Frage::new()"]
    Frage:sw -> Addr:se [label = "Frage::address()"]
}
