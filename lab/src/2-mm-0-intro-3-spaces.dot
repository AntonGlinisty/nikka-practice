digraph diagram {
    rankdir = LR
    ranksep = 1.5

    fontname="Helvetica,Arial,sans-serif"

    node [shape = box; width = 1.0; height = 0.5; style = filled; fillcolor = "#CCCCCC"]
    edge [arrowhead = vee]

    subgraph cluster_phys_memory {
        label = "Физическое"
        labelloc = "t"

        Phys
    }

    subgraph cluster_virt_memory {
        label = "Виртуальное"
        labelloc = "t"

        Virt
    }

    Phys:ne -> Virt:nw [label = "Phys2Virt::map()"]
    Virt:sw -> Phys:se [constraint = false; label = "Mapping::translate()"]
}
