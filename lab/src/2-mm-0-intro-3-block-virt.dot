digraph diagram {
    rankdir = LR
    ranksep = 2.5
    nodesep = 1

    fontname="Helvetica,Arial,sans-serif"

    node [shape = box; width = 1.0; height = 0.5; style = filled; fillcolor = "#CCCCCC"]
    edge [arrowhead = vee]

    Virt [label = "\nVirt\n\nBlock::<Virt>\n\nBlock::<Page>\n "]

    const_ptr [label = "*const T"]
    const_ref [label = "&T"]
    const_slice [label = "&[T]"]

    mut_ptr [label = "*mut T"]
    mut_ref [label = "&mut T"]
    mut_slice [label = "&mut [T]"]

    const_ptr:ne -> Virt:n [label = "from_ptr<T>()"]
    const_ref:ne -> Virt [label = "from_ref<T>()"]
    const_slice:ne -> Virt:sw [label = "from_slice<T>()"]

    Virt:nw -> const_ptr:se [constraint = false; label = "try_into_ptr<T>()?"]
    Virt -> const_ref:se [constraint = false; label = "try_into_ref<T>()?"]
    Virt:s -> const_slice:se [constraint = false; label = "try_into_slice<T>()?"]
    Virt:ne -> mut_ptr:w [label = "try_into_mut_ptr<T>()?"]
    Virt:e -> mut_ref:w [label = "try_into_mut<T>()?"]
    Virt:se -> mut_slice:w [label = "try_into_mut_slice<T>()?"]
}
