digraph diagram {
    rankdir = LR
    ranksep = 1.5

    fontname="Helvetica,Arial,sans-serif"

    node [shape = box; width = 1.0; height = 0.5; style = filled; fillcolor = "#CCCCCC"]
    edge [arrowhead = vee]

    Phys
    Frame

    Phys:ne -> Frame:nw [label = "Frame::new()"]
    Frame:sw -> Phys:se [label = "Frame::address()"]
}
